{
  "name": "prompt-vault",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run release:check && pnpm run verify:release && wrangler deploy --experimental-auto-create=false",
    "verify:release": "pnpm run typecheck && pnpm run test && pnpm run build",
    "release:check": "node scripts/release-check.mjs",
    "cf-typegen": "wrangler types --experimental-auto-create=false",
    "typecheck": "wrangler types --experimental-auto-create=false && react-router typegen && tsc -b",
    "test": "node scripts/vitest-safe-ports.mjs && node --test scripts/release-check.check.mjs",
    "db:migrate:local": "wrangler d1 migrations apply prompt-vault-db --local --experimental-auto-create=false",
    "db:migrate:remote": "wrangler d1 migrations apply prompt-vault-db --remote --experimental-auto-create=false"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.36",
    "jose": "^6.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.11",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.0",
    "wrangler": "4.133.0"
  }
}
